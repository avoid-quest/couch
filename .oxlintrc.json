{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "src/client/routeTree.gen.ts",
    "vendor/**"
  ],
  "rules": {
    "no-control-regex": "off",
    "unicorn/no-useless-spread": "off",
    "oxc/only-used-in-recursion": "off"
  },
  "overrides": [
    {
      "files": [
        "tests/**"
      ],
      "rules": {
        "typescript/no-this-alias": "off"
      }
    }
  ]
}
