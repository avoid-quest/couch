#!/bin/bash
# Install authenticated, locally downloaded AppImage and appliance package on Ubuntu Server.
set -euo pipefail
fail() { echo "install-couch: $*" >&2; exit 1; }
[[ $EUID = 0 ]] || fail 'Run with sudo from your SSH administrator account.'
[[ $# -ge 2 ]] || fail 'Usage: sudo bash install-couch /absolute/Couch.AppImage /absolute/couch-appliance.deb [--data-dir /existing/data] [--release-key FILE --release-key-sha256 SHA256 --release-feed URL]'
app=$(realpath "$1")
session=$(realpath "$2")
shift 2
data= release_key= release_key_sha256= release_feed=
while [[ $# -gt 0 ]]; do
    [[ $# -ge 2 ]] || fail "Missing value for $1"
    case $1 in
        --data-dir) data=$2 ;;
        --release-key) release_key=$2 ;;
        --release-key-sha256) release_key_sha256=$2 ;;
        --release-feed) release_feed=$2 ;;
        *) fail "Unknown option: $1" ;;
    esac
    shift 2
done
if [[ -n $release_key$release_key_sha256$release_feed ]]; then
    [[ $release_key = /* && -f $release_key && $release_key_sha256 =~ ^[a-f0-9]{64}$ ]] || fail 'Supply the authenticated absolute public-key file and its SHA256 from the trusted Mac.'
    [[ $(sha256sum "$release_key" | cut -d ' ' -f1) = "$release_key_sha256" ]] || fail 'Release key SHA256 mismatch.'
    if [[ -f /etc/couch/appimage-update.json ]]; then
        command -v jq >/dev/null || fail 'Install jq before changing existing updater trust.'
        jq -e --rawfile pubkey "$release_key" '.pubkey == ($pubkey|rtrimstr("\n"))' /etc/couch/appimage-update.json >/dev/null || fail 'Existing updater signing key differs. Rotate it deliberately through SSH.'
    fi
    [[ $release_feed =~ ^https?://[A-Za-z0-9.:_-]+(/[A-Za-z0-9._~/{}/-]*)?$ ]] || fail 'Supply the LAN/HTTPS feed endpoint (use {channel} for the selected channel).'
fi
. /etc/os-release
[[ $ID = ubuntu && $VERSION_ID = 24.04 && $(dpkg --print-architecture) = amd64 ]] || fail 'Ubuntu 24.04 amd64 is required.'
[[ -d /run/systemd/system ]] || fail 'Boot Ubuntu with systemd before running the installer.'
exec 9>/run/couch-install.lock
flock -n 9 || fail 'Another Couch installation is running.'
state=/var/lib/couch-installer
install -d -o root -g root -m 0700 "$state"
policy=/usr/sbin/policy-rc.d
restore_policy() {
    [[ -e $state/policy-active ]] || return 0
    rm -f "$policy"
    if [[ -e $state/original-policy || -L $state/original-policy ]]; then cp -a "$state/original-policy" "$policy"; fi
    sync -f /usr/sbin
    rm -f "$state/policy-active"
    sync -f "$state"
    rm -f "$state/original-policy"
}
# A previous run may have lost power while its temporary deny policy was active.
restore_policy
[[ -f $app && $app = *.AppImage && $(dpkg-deb -f "$session" Package) = couch-appliance ]] || fail 'Expected a trusted Couch AppImage and Couch appliance package.'
[[ ! -e /etc/X11/default-display-manager || $(cat /etc/X11/default-display-manager) = /usr/sbin/lightdm ]] || fail 'This machine already uses another display manager.'

config=/etc/couch/appliance.env
had_config=false
[[ ! -e $config ]] || had_config=true
pending=false
if [[ -f $state/data-path ]]; then
    requested=$(cat "$state/data-path")
    [[ -z $data || $data = "$requested" ]] || fail 'Complete the interrupted install with its original data path first.'
    data=$requested
    pending=true
fi
if [[ -n $data ]]; then
    [[ $data = /* && -d $data && ! -L $data ]] || fail '--data-dir must name an existing absolute directory.'
    data=$(realpath "$data")
    [[ $data != / && $data != /home && $data != /var && $data != /usr && $data != *$'\n'* && $data != *'"'* && $data != *\\* ]] || fail 'Choose a dedicated Couch data directory.'
    if $had_config && ! $pending; then
        grep -Fxq "COUCH_DATA_DIR=\"$data\"" "$config" || grep -Fxq "COUCH_DATA_DIR=$data" "$config" || fail 'An appliance data location is already configured. Keep it on reinstall, or edit /etc/couch/appliance.env deliberately.'
    fi
elif [[ ! -e $config && -n ${SUDO_USER:-} ]]; then
    administrator_home=$(getent passwd "$SUDO_USER" | cut -d: -f6)
    [[ ! -d $administrator_home/.local/share/quest.avoid.couch ]] || fail 'Existing administrator data found. Re-run with --data-dir pointing to that directory.'
fi
if [[ -n $data ]] && ! $had_config && ! $pending; then
    printf '%s\n' "$data" > "$state/data-path"
    sync -f "$state"
    pending=true
fi

# Suppress maintainer-script service starts until both packages and dependencies
# are configured. Preserve the administrator's existing policy on every exit.
rm -f "$state/original-policy"
[[ ! -e $policy && ! -L $policy ]] || cp -a "$policy" "$state/original-policy"
sync -f "$state"
touch "$state/policy-active"
sync -f "$state"
trap restore_policy EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
rm -f "$policy"
printf '#!/bin/sh\nexit 101\n' > "$policy"
chmod 0755 "$policy"
# Disable the obsolete root worker before any package/session mutation. Retain its
# historical receipts and backups, but never let it restart a competing app.
systemctl disable --now couch-updater.socket couch-updater.service 2>/dev/null || true
! systemctl is-active --quiet couch-updater.service || fail 'The legacy updater is still active; inspect it through SSH.'
if getent passwd couch-tv >/dev/null; then
    uid=$(id -u couch-tv)
    if [[ -S /run/user/$uid/bus ]]; then
        runuser -u couch-tv -- env XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" systemctl --user stop couch-tv.service
    fi
fi
if systemctl is-active --quiet lightdm; then systemctl stop lightdm; fi
# Keep an interrupted transaction from booting into a half-configured session.
systemctl mask lightdm.service
sync -f /etc/systemd/system
# Keep a consistent migration snapshot after all legacy writers have stopped.
if getent passwd couch-tv >/dev/null; then
    ! pgrep -u couch-tv -x 'couch|couch-server' >/dev/null || fail 'A Couch writer remains; inspect it through SSH before retrying.'
fi
if [[ -z $data && -f $config ]]; then
    data=$(sed -n 's/^COUCH_DATA_DIR=//p' "$config" | tail -1)
    data=${data#\"}; data=${data%\"}
fi
data=${data:-/var/lib/couch/.local/share/quest.avoid.couch}
migration="$state/migration-$(date -u +%Y%m%dT%H%M%SZ)-$$"
install -d -m 0700 "$migration"
[[ ! -d $data ]] || cp -a "$data" "$migration/data"
[[ ! -f $config ]] || cp -a "$config" "$migration/appliance.env"
if [[ -f /var/lib/couch/application/Couch.AppImage ]]; then
    cp -a /var/lib/couch/application/Couch.AppImage /var/lib/couch/application/build.json "$migration/"
    (cd "$migration" && sha256sum Couch.AppImage > SHA256SUMS)
fi
# Preserve the installed Debian binaries for deliberate operator diagnosis.
[[ ! -x /usr/bin/couch ]] || cp -a /usr/bin/couch /usr/bin/couch-server "$migration/"
sync -f "$migration"
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends -o Dpkg::Options::=--force-confold "$session"

install -d -o couch-tv -g couch-tv -m 0700 /var/lib/couch/application
install -o couch-tv -g couch-tv -m 0700 "$app" /var/lib/couch/application/Couch.AppImage.new
# Probe as the runtime account: AppImage extraction caches must not be root-owned.
runuser -u couch-tv -- /var/lib/couch/application/Couch.AppImage.new --version > "$state/build.json"
jq -e '.version | type == "string"' "$state/build.json" >/dev/null
jq -e '.dataFormat == 1 and (.revision | test("^[a-f0-9]{40}$"))' "$state/build.json" >/dev/null
jq --arg hash "$(sha256sum /var/lib/couch/application/Couch.AppImage.new | cut -d ' ' -f1)" '. + {archiveSha256:$hash}' "$state/build.json" > "$state/build-with-hash.json"
mv "$state/build-with-hash.json" "$state/build.json"
# Remove the old application package only after the companion no longer depends
# on it. Data lives outside both packages and is never restored automatically.
if dpkg-query -W -f='${db:Status-Status}' couch 2>/dev/null | grep -qx installed; then
    DEBIAN_FRONTEND=noninteractive apt-get remove --yes couch
fi
rm -f /etc/apt/sources.list.d/couch.sources
rm -f /etc/systemd/system/couch-updater.service.d/90-transaction.conf
install -o couch-tv -g couch-tv -m 0600 "$state/build.json" /var/lib/couch/application/build.json
mv -f /var/lib/couch/application/Couch.AppImage.new /var/lib/couch/application/Couch.AppImage
sync -f /var/lib/couch/application
if [[ -n $release_key ]]; then
    jq -n --arg endpoint "$release_feed" --rawfile pubkey "$release_key" '{endpoint:$endpoint,pubkey:($pubkey|rtrimstr("\n"))}' > "$state/appimage-update.json"
    if [[ -f /etc/couch/appimage-update.json ]]; then
        jq -e --rawfile pubkey "$release_key" '.pubkey == ($pubkey|rtrimstr("\n"))' /etc/couch/appimage-update.json >/dev/null || fail 'Existing updater signing key differs. Rotate it deliberately through SSH.'
    fi
    install -o root -g root -m 0644 "$state/appimage-update.json" /etc/couch/appimage-update.json
fi

if [[ -n $data ]]; then
    [[ -d $data ]] || install -d -o couch-tv -g couch-tv -m 0700 "$data"
    # Preserve original ownership and permit only the new runtime account.
    setfacl -R -m u:couch-tv:rwX "$data"
    find "$data" -type d -exec setfacl -m d:u:couch-tv:rwx {} +
    parent=$(dirname "$data")
    while [[ $parent != / ]]; do setfacl -m u:couch-tv:x "$parent"; parent=$(dirname "$parent"); done
    if $pending; then
        if [[ -f $config ]]; then
            awk -v data="$data" '/^COUCH_DATA_DIR=/{next} {print} END {print "COUCH_DATA_DIR=\"" data "\""}' "$config" > "$state/config"
        else
            printf 'COUCH_DATA_DIR="%s"\n' "$data" > "$state/config"
        fi
        install -m 0644 "$state/config" "$config"
        sync -f "$config"
        rm -f "$state/config" "$state/data-path"
        sync -f "$state"
    fi
fi
restore_policy
trap - EXIT
systemctl unmask lightdm.service
systemctl daemon-reload
systemctl kill --kill-whom=main --signal=HUP systemd-logind.service
systemctl restart systemd-journald.service
udevadm trigger --subsystem-match=input --action=change
udevadm settle --timeout=10
systemctl enable lightdm.service
systemctl set-default graphical.target
systemctl start lightdm.service
echo 'Couch TV is starting. The SSH administrator and existing data are preserved.'
echo 'Inspect startup with: sudo couch-session status'
