#!/bin/bash
# Run only from the authenticated setup archive. See docs/install-couch.md.
set -euo pipefail
fail() { echo "install-couch: $*" >&2; exit 1; }
usage='sudo ./install-couch --appimage FILE --signature FILE.sig --public-key couch-updater.pub [--desktop-user USER | --tv]'
app= signature= public_key= desktop_user= tv=false first_tv=false
while [[ $# -gt 0 ]]; do
    if [[ $1 = --tv ]]; then tv=true; shift; continue; fi
    [[ $# -ge 2 ]] || fail "$usage"
    case $1 in
        --appimage) app=$2 ;; --signature) signature=$2 ;; --public-key) public_key=$2 ;;
        --desktop-user) desktop_user=$2 ;; *) fail "$usage" ;;
    esac
    shift 2
done
. /etc/os-release
architecture=$(dpkg --print-architecture)
[[ $ID = debian && $VERSION_ID = 13 && $architecture = amd64 ]] || fail "Detected $ID $VERSION_ID $architecture; supported target is Debian 13 x86_64/X11."
[[ $EUID = 0 ]] || fail "$usage"
[[ -d /run/systemd/system ]] || fail 'Boot Debian with systemd before setup.'
[[ -f $app && -f $signature && -f $public_key ]] || fail "$usage"
for tool in minisign jq; do command -v "$tool" >/dev/null || fail "Install the bootstrap verifier with: sudo apt-get install minisign jq"; done
setup=$(cd -- "$(dirname -- "$0")" && pwd)
[[ -f $setup/host-packages.json ]] || fail 'Run the installer from the verified, extracted setup archive.'
$tv && [[ -z $desktop_user ]] || ! $tv || fail 'Choose either --tv or --desktop-user.'
if $tv; then
    desktop_user=couch-tv
    [[ -f /var/lib/couch-installer/tv-files.sha256 ]] || first_tv=true
    if [[ -e /etc/X11/default-display-manager ]]; then
        [[ $(cat /etc/X11/default-display-manager) = /usr/sbin/lightdm ]] || fail 'Another display manager is configured. Keep this desktop or select LightDM deliberately before TV setup.'
        [[ -f /var/lib/couch-installer/tv-files.sha256 ]] || fail 'LightDM already has a desktop policy. Use ordinary installation, or configure TV login deliberately before setup.'
    fi
    if getent passwd couch-tv >/dev/null; then
        [[ $(getent passwd couch-tv | cut -d: -f6) = /var/lib/couch && $(id -Gn couch-tv) = couch-tv && $(passwd -S couch-tv | awk '{print $2}') = L ]] || fail 'The existing couch-tv account is not the locked Couch runtime account.'
    fi
    user_home=/var/lib/couch
    application=$user_home/application
else
    desktop_user=${desktop_user:-${SUDO_USER:-}}
    [[ -n $desktop_user && $desktop_user != root && $desktop_user != couch-tv ]] || fail 'Select the ordinary desktop account with --desktop-user USER.'
    user_home=$(getent passwd "$desktop_user" | cut -d: -f6)
    [[ $user_home = /* && -d $user_home ]] || fail 'The selected desktop user needs an existing home directory.'
    # A graphical login may not be active yet, but an installed X11 session is required.
    compgen -G '/usr/share/xsessions/*.desktop' >/dev/null || fail 'An existing X11 desktop is required. Use --tv for a minimal Debian device.'
    [[ ${XDG_SESSION_TYPE:-x11} = x11 ]] || fail 'Log into an X11 desktop before installing Couch.'
    application=$user_home/.local/lib/couch
fi
[[ $user_home != *$'\n'* && $user_home != *'"'* && $user_home != *'%'* ]] || fail 'The account home path cannot be used in desktop integration.'
exec 9>/run/couch-install.lock
flock -n 9 || fail 'Another Couch installation is running.'
staging=$(mktemp -d)
trap 'rm -rf -- "$staging"' EXIT
# Verify private copies before any host/package/account mutation or app execution.
cp -- "$app" "$staging/Couch.AppImage"
base64 --decode < "$public_key" > "$staging/key"
base64 --decode < "$signature" > "$staging/signature"
minisign -Vm "$staging/Couch.AppImage" -p "$staging/key" -x "$staging/signature" || fail 'AppImage signature verification failed.'
if [[ -f $application/Couch.AppImage ]]; then
    cmp -s "$staging/Couch.AppImage" "$application/Couch.AppImage" || fail 'A different Couch app is installed. Use its signed app updater; setup preserves existing app bytes and data.'
fi
if $tv; then
    # Refuse unknown session overrides before installing packages or changing login.
    [[ ! -e /etc/systemd/system/couch-tv.service && ! -e /etc/systemd/user/couch-tv.service ]] || fail 'An administrator Couch service override exists. Inspect it before TV setup.'
fi
mapfile -t packages < <(jq -r '.common[]' "$setup/host-packages.json")
if $tv; then mapfile -t extra < <(jq -r '.audio[], .tv[]' "$setup/host-packages.json"); packages+=("${extra[@]}")
elif ! dpkg-query -W -f='${db:Status-Status}\n' pulseaudio pipewire-pulse 2>/dev/null | grep -qx installed; then
    mapfile -t extra < <(jq -r '.audio[]' "$setup/host-packages.json"); packages+=("${extra[@]}")
fi
# Ordinary setup never stops/enables a display manager, changes login, or changes power policy.
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends "${packages[@]}"
for package in "${packages[@]}"; do
    [[ $(dpkg-query -W -f='${db:Status-Status}' "$package" 2>/dev/null) = installed ]] || fail "Debian package $package is missing after APT. Inspect the APT result and rerun setup."
done
for command in fusermount3 xrandr xset pactl dbus-send bwrap xdg-dbus-proxy; do command -v "$command" >/dev/null || fail "Host command $command is missing after Debian setup."; done
[[ -c /dev/fuse ]] || fail 'The FUSE device /dev/fuse is missing. Enable the Debian fuse kernel module and rerun setup.'
if $tv && ! getent passwd couch-tv >/dev/null; then
    adduser --system --group --home /var/lib/couch --shell /bin/sh couch-tv
    runuser -u couch-tv -- mkdir -p "$user_home/.local/state/couch-appliance"
    runuser -u couch-tv -- touch "$user_home/.local/state/couch-appliance/initialize-audio"
fi
as_user() { runuser -u "$desktop_user" -- env HOME="$user_home" "$@"; }
as_user test -r /dev/fuse && as_user test -w /dev/fuse || fail "The $desktop_user account cannot access /dev/fuse. Fix Debian device permissions before launch."
as_user mkdir -p "$application"
# Every write in the user-owned tree runs as that user, including on repeat setup.
if [[ ! -f $application/Couch.AppImage ]]; then
    as_user sh -c 'umask 077; cat > "$1/Couch.AppImage.new"; chmod 0700 "$1/Couch.AppImage.new"' sh "$application" < "$staging/Couch.AppImage"
    as_user "$application/Couch.AppImage.new" --version > "$staging/build.json" || fail 'The verified AppImage cannot start. Inspect FUSE, CPU and host-library requirements.'
    jq -e '.packaged == true and .target == "x86_64-unknown-linux-gnu" and .dataFormat == 1 and (.revision | test("^[a-f0-9]{40}$")) and (.helpers | has("ffprobe") and has("yt-dlp") and has("deno"))' "$staging/build.json" >/dev/null || fail 'This is not a complete supported Couch build.'
    jq --arg hash "$(sha256sum "$staging/Couch.AppImage" | cut -d ' ' -f1)" '. + {archiveSha256: $hash}' "$staging/build.json" > "$staging/build-with-hash.json"
    as_user sh -c 'umask 077; cat > "$1/build.json"' sh "$application" < "$staging/build-with-hash.json"
    as_user sh -c 'umask 077; cat > "$1/Couch.AppImage.sig"' sh "$application" < "$signature"
    as_user mv -f "$application/Couch.AppImage.new" "$application/Couch.AppImage"
    sync -f "$application"
fi
as_user mkdir -p "$user_home/.local/bin"
as_user sh -c 'cat > "$1/.local/bin/couch-recover"; chmod 0700 "$1/.local/bin/couch-recover"' sh "$user_home" < "$setup/couch-recover"
if ! $tv; then
    as_user mkdir -p "$user_home/.local/share/applications" "$user_home/.local/share/icons"
    as_user sh -c 'cat > "$1/.local/share/icons/couch.png"' sh "$user_home" < "$setup/couch.png"
    printf '[Desktop Entry]\nType=Application\nName=Couch\nExec="%s/Couch.AppImage"\nIcon=%s/.local/share/icons/couch.png\nTerminal=false\nCategories=AudioVideo;\n' "$application" "$user_home" | as_user sh -c 'cat > "$1/.local/share/applications/couch.desktop"' sh "$user_home"
    echo "Installed Couch for $desktop_user. Launch Couch from the desktop application menu in an X11 session."
else
    state=/var/lib/couch-installer
    install -d -m 0700 "$state"
    touch "$state/tv-files.sha256"
    while IFS= read -r file; do
        source=$setup/tv/$file
        destination=/$file
        previous=$(awk -v path="$file" '$2 == path {print $1}' "$state/tv-files.sha256")
        if [[ -e $destination || -L $destination ]]; then
            if [[ -L $destination || -z $previous || $(sha256sum "$destination" | cut -d ' ' -f1) != "$previous" ]]; then
                echo "Preserved administrator file $destination"
                continue
            fi
        fi
        install -D -m "$(stat -c '%a' "$source")" "$source" "$destination"
        awk -v path="$file" '$2 != path' "$state/tv-files.sha256" > "$staging/tv-files.sha256"
        printf '%s  %s\n' "$(sha256sum "$source" | cut -d ' ' -f1)" "$file" >> "$staging/tv-files.sha256"
        install -m 0600 "$staging/tv-files.sha256" "$state/tv-files.sha256"
    done < <(jq -r '.files[]' "$setup/host-packages.json")
    install -m 0755 "$setup/couch-recover" /usr/sbin/couch-recover
    systemctl daemon-reload
    if $first_tv; then
        systemctl enable lightdm.service
        systemctl set-default graphical.target
    fi
    echo 'TV setup is ready. Reboot when convenient to start the Couch session.'
    echo 'Keep your administrator account. Recovery: sudo couch-session logs; sudo couch-session restart'
fi
echo 'App data stays separate from the AppImage. Debian maintenance remains with the machine administrator.'
echo 'Address: enable Allow remote control in Couch, then use the displayed LAN IP and port 4100. No firewall or router rule was changed.'
