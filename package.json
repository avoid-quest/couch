{
  "name": "couch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0 <1.5.0"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun scripts/build.ts",
    "desktop": "bun scripts/desktop.ts dev --no-dev-server",
    "desktop:build": "bun scripts/desktop.ts build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:linux": "bun scripts/linux-test.ts",
    "setup:media": "bun scripts/setup-media.ts",
    "preview:linux": "bun scripts/preview.ts",
    "preview:linux:stop": "bun scripts/preview.ts stop",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@iptv/playlist": "1.2.1",
    "@jellyfin/sdk": "0.13.0",
    "@tauri-apps/api": "2.11.1",
    "axios": "1.20.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.5",
    "lucide-react": "1.41.0",
    "music-metadata": "11.15.0",
    "qrcode.react": "4.2.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/bun": "1.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "bun": "1.4.2",
    "bun-plugin-tailwind": "0.1.2",
    "shadcn": "4.21.0",
    "typescript": "7.0.2"
  }
}
