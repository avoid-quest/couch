{
  "name": "couch",
  "productName": "Couch",
  "identifier": "quest.avoid.couch",
  "version": "0.3.1",
  "description": "Shared media player for your TV, controlled from any phone",
  "homepage": "https://couch.avoid.quest",
  "author": {
    "name": "avoid-quest",
    "email": "support@avoid.quest"
  },
  "main": "build/main.mjs",
  "desktopName": "couch.desktop",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0 <1.5.0",
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun run --parallel server:dev client:dev",
    "server:dev": "bun scripts/core.ts --watch",
    "start": "node build/core.mjs",
    "client:dev": "bun --bun vite",
    "build": "bun scripts/build.ts",
    "app": "bun run build && bun scripts/app.ts",
    "package": "bun run build && bun scripts/package.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts && tsc --noEmit -p app",
    "web:dev": "bun run --cwd apps/web dev",
    "web:build": "bun run --cwd apps/web build",
    "web:deploy": "bun run --cwd apps/web deploy"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@iptv/playlist": "1.2.1",
    "@sendspin/sendspin-js": "5.0.0",
    "@sonn-audio/node-sendspin": "0.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-hotkeys": "^0.12.0",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/router-plugin": "^1.168.38",
    "@types/bun": "1.4.1",
    "@types/node": "24.19.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "bun": "1.4.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.5",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "fast-xml-parser": "5.11.1",
    "fflate": "0.8.3",
    "hls.js": "1.7.3",
    "input-otp": "^1.5.0",
    "lucide-react": "1.41.0",
    "mpegts.js": "1.8.2",
    "qrcode.react": "4.2.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "4.3.3",
    "timing-object": "3.1.98",
    "timingsrc": "1.4.37",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "ws": "8.22.0"
  },
  "workspaces": [
    ".",
    "apps/*"
  ],
  "build": {
    "appId": "quest.avoid.couch",
    "artifactName": "Couch-${version}-${arch}.${ext}",
    "directories": {
      "output": ".artifacts/app",
      "buildResources": "packaging/icons"
    },
    "files": [
      "package.json",
      "build/main.mjs",
      "build/preload.cjs",
      "build/core.mjs",
      "dist/**",
      "packaging/icons/icon.png",
      "packaging/icons/preview/icon.png",
      "packaging/icons/tray-template.png"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "packaging/icons/icon.icns",
      "category": "public.app-category.entertainment",
      "identity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "14.0",
      "extendInfo": {
        "NSAudioCaptureUsageDescription": "Couch shares this computer's audio with the devices you choose.",
        "NSMicrophoneUsageDescription": "Couch shares your microphone or audio input with the devices you choose."
      }
    },
    "win": {
      "target": "nsis",
      "icon": "packaging/icons/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "packaging/icons/icon.png",
      "executableName": "couch",
      "category": "AudioVideo",
      "synopsis": "Shared media player for your TV"
    },
    "deb": {
      "artifactName": "${name}_${version}_${arch}.${ext}",
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libgbm1",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "pulseaudio-utils",
        "pulseaudio | pipewire-pulse"
      ],
      "fpm": [
        "packaging/tv/=/usr/share/couch/tv/",
        "packaging/couch-setup=/usr/sbin/couch-setup"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "avoid-quest",
      "repo": "couch"
    }
  }
}
