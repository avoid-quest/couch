{
  "name": "couch",
  "version": "0.2.0-preview.19",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0 <1.5.0",
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun run --parallel server:dev client:dev",
    "server:dev": "bun scripts/core.ts --watch",
    "start": "node build/core.mjs",
    "client:dev": "bun --bun vite",
    "build": "bun scripts/build.ts",
    "desktop": "bun scripts/desktop.ts dev --config src-tauri/tauri.dev.conf.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "setup:media": "bun scripts/setup-media.ts",
    "web:dev": "bun run --cwd apps/web dev",
    "web:build": "bun run --cwd apps/web build",
    "web:deploy": "bun run --cwd apps/web deploy"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@iptv/playlist": "1.2.1",
    "@tanstack/react-hotkeys": "^0.12.0",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "^1.170.36",
    "@tauri-apps/api": "2.11.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.5",
    "fast-xml-parser": "5.11.1",
    "input-otp": "^1.5.0",
    "lucide-react": "1.41.0",
    "qrcode.react": "4.2.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.38",
    "@tauri-apps/cli": "2.11.4",
    "@types/bun": "1.4.1",
    "@types/node": "24.19.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "bun": "1.4.2",
    "electron": "44.4.5",
    "hls.js": "1.7.3",
    "mpegts.js": "1.8.2",
    "shadcn": "4.21.0",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "workspaces": [
    ".",
    "apps/*"
  ]
}
