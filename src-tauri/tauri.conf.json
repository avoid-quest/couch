{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Couch",
  "version": "0.1.5-preview.9",
  "identifier": "quest.avoid.couch",
  "build": {
    "beforeDevCommand": {
      "script": "bun run client:dev",
      "wait": true
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Couch",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "fullscreen": true,
        "decorations": false,
        "backgroundColor": "#0b1119",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "A media player for your library and online sources",
    "targets": [
      "deb"
    ],
    "externalBin": [
      "binaries/couch-server"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libmpv2",
          "libgl1",
          "va-driver-all"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": ""
    }
  }
}
