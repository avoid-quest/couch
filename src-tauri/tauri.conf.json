{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Couch",
  "version": "0.2.0-preview.19",
  "identifier": "quest.avoid.couch",
  "build": {
    "beforeDevCommand": "bun run client:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Couch",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark",
        "titleBarStyle": "Transparent",
        "hiddenTitle": false,
        "scrollBarStyle": "fluentOverlay",
        "transparent": true,
        "backgroundColor": "#000000",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "Shared media player for your TV, controlled from any phone",
    "longDescription": "Couch plays online video, music, live TV and radio on your TV or this computer. Pair phones and laptops as remotes and build one queue together.",
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "targets": [
      "deb"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libmpv2",
          "libgl1",
          "va-driver-all"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
