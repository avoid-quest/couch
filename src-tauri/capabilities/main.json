{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The bundled TV interface can use app commands and window events.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-connection-info",
    "allow-set-video-rect",
    "allow-playback-device",
    "allow-select-playback-device",
    "allow-forget-playback-device",
    "allow-retry-playback-device",
    "allow-complete-local-setup",
    "allow-desktop-interface-size",
    "allow-set-now-playing",
    "allow-set-native-window-title",
    "allow-set-native-cursor-visible",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-cursor-visible"
  ]
}
