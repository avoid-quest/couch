{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The bundled TV interface can use app commands and window events.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-connection-info",
    "allow-native-receiver-begin",
    "allow-native-receiver-request",
    "allow-native-receiver-renew",
    "allow-native-receiver-command",
    "allow-native-receiver-report",
    "allow-native-receiver-end",
    "allow-native-audio-begin",
    "allow-native-audio-renew",
    "allow-native-audio-end",
    "allow-native-video-state",
    "allow-native-video-command",
    "allow-set-video-rect",
    "allow-choose-media",
    "allow-choose-folder",
    "allow-save-metadata-export",
    "allow-save-diagnostics-export",
    "allow-playback-device",
    "allow-select-playback-device",
    "allow-forget-playback-device",
    "allow-retry-playback-device",
    "allow-complete-local-setup",
    "allow-local-update-activity",
    "allow-desktop-interface-size",
    "allow-set-now-playing",
    "allow-set-native-window-title",
    "allow-set-native-cursor-visible",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-cursor-visible"
  ]
}
