{
  "bundle": {
    "targets": ["deb"],
    "resources": {
      "resources/tools/": "tools/",
      "resources/tools.json": "tools.json",
      "resources/build-inputs.json": "build-inputs.json",
      "resources/build-packages.tsv": "build-packages.tsv"
    },
    "linux": {
      "deb": {
        "depends": ["gpgv", "dpkg", "libmpv2", "libgl1", "va-driver-all", "ffmpeg", "ca-certificates", "fonts-dejavu-core", "libxdo3"],
        "files": {
          "/usr/share/doc/couch": "resources/notices/",
          "/usr/share/doc/couch/build-info.json": "build-info.json"
        }
      }
    }
  }
}
