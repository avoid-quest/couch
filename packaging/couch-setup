#!/bin/bash
# Optional setup from the installed Debian package. Never run from a package hook.
set -euo pipefail
fail() { echo "couch-setup: $*" >&2; exit 1; }
usage='sudo couch-setup --tv, or sudo couch-setup --inspect'
# --refresh, run by the TV's update script, applies the files and packages a
# newer release adds to a completed setup and leaves everything else alone.
# --inspect reports what --tv would change, keep or refuse, with the same checks.
# It writes nothing: no file, lock, account, package or service.
inspect=false
case "$*" in
    --tv) mode=tv ;;
    --refresh) mode=refresh ;;
    --inspect) mode=tv inspect=true ;;
    *) fail "$usage" ;;
esac
$inspect || trap 'status=$?; if [[ $status != 0 ]]; then echo "Setup did not complete. Existing data was retained. Inspect sudo couch-session logs; rerun couch-setup." >&2; fi' EXIT
# Tests run setup against a fixture tree; sudo and the update service never set it.
root=${COUCH_SETUP_ROOT:-}
refusals=() actions=() kept=() unknown=()
# Setup stops at the first refusal; inspection lists every one.
refuse() { $inspect || fail "$1"; refusals+=("$1"); }
# exists PATH: 0 present (a symbolic link counts), 1 absent, 2 only root can tell.
exists() {
    [[ ! -e $root$1 && ! -L $root$1 ]] || return 0
    [[ $(LC_ALL=C stat -- "$root$1" 2>&1) != *'Permission denied'* ]] || return 2
    return 1
}
$inspect || [[ $EUID = 0 ]] || fail "$usage"
[[ $EUID = 0 ]] || unknown+=('Run with sudo to read what only root can.')
ID= VERSION_ID=
[[ ! -r $root/etc/os-release ]] || . "$root/etc/os-release"
[[ $ID = debian && $VERSION_ID = 13 && $(dpkg --print-architecture) = amd64 ]] || refuse 'Supported target: Debian 13 amd64.'
[[ -d $root/run/systemd/system ]] || refuse 'Boot Debian with systemd before setup.'
[[ $(dpkg-query -W -f='${db:Status-Status}' couch) = installed ]] || refuse 'Install the Couch package with APT first.'
[[ -x $root/usr/bin/couch ]] || refuse 'The Couch executable is missing. Reinstall its Debian package.'
desktop_user=couch-tv
user_home=/var/lib/couch
state=/var/lib/couch-installer/native-tv
lock=/var/lib/couch-install-locks/tv.lock
templates=/usr/share/couch/tv
# How far an earlier --tv got here: complete, pending (interrupted) or none.
previous=none
if [[ -f $root/var/lib/couch-installer/tv-setup.complete || -f $root$state/complete ]]; then previous=complete
elif [[ -f $root$state/pending ]]; then previous=pending
elif exists "$state/complete"; then :
elif [[ $? = 2 ]]; then previous=unknown unknown+=('Whether TV setup ran before')
fi
if [[ $mode = refresh && ! -f $root$state/complete ]]; then
    echo 'TV setup is not complete; nothing to refresh.'
    exit 0
fi
# The packages and files setup applies, read once here: a missing, unreadable or empty
# list refuses before anything changes, rather than applying nothing and completing.
packages=() files=()
if ! { mapfile -t packages < "$root$templates/packages" && mapfile -t files < "$root$templates/files"; } 2>/dev/null \
    || [[ ${#packages[@]} = 0 || ${#files[@]} = 0 ]]; then
    refuse "The Couch package's TV lists in $templates are missing or unreadable. Reinstall its Debian package."
fi
as_user() { runuser -u "$desktop_user" -- env HOME="$user_home" "$@"; }
user_systemctl() { as_user env XDG_RUNTIME_DIR="/run/user/$(id -u "$desktop_user")" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u "$desktop_user")/bus" systemctl --user "$@"; }
# Fixed root-owned state and lock paths; do not follow substituted directories.
for directory in /var/lib/couch-installer /var/lib/couch-install-locks "$state"; do
    if [[ -L $root$directory ]]; then refuse "Refusing symbolic link: $directory"; continue; fi
    if [[ ! -d $root$directory ]]; then
        $inspect && { actions+=("Create $directory"); continue; }
        install -d -m 0755 "$root$directory"
    fi
    [[ $(stat -c %u "$root$directory") = 0 && -z $(find "$root$directory" -maxdepth 0 -perm /022 -print) ]] || refuse "Root must own $directory."
done
[[ ! -L $root$lock ]] || refuse 'The installation lock is a symbolic link.'
# Inspection never takes the lock: it looks for a holder in the kernel's lock table,
# whose entries name the file's device (hex major:minor) and inode.
# 0 held, 1 free, 2 unknown (the table and the file's identity can't be matched).
lock_held() {
    local device inode key
    [[ -e $root$lock ]] || return 1
    read -r device inode < <(stat -c '%d %i' -- "$root$lock" 2>/dev/null) && [[ -r /proc/locks ]] || return 2
    key=$(printf '%02x:%02x:%d' $(( (device >> 8 & 0xfff) | (device >> 32 & ~0xfff) )) $(( (device & 0xff) | (device >> 12 & ~0xff) )) "$inode")
    awk -v key="$key" -v inode=":$inode" '$0 ~ " " key " " { held = 1 } index($0, inode " ") { other = 1 } END { exit held ? 0 : other ? 2 : 1 }' /proc/locks
}
if $inspect; then
    if lock_held; then refuse 'Another Couch installation or recovery is running.'
    elif [[ $? = 2 ]]; then unknown+=('Whether another Couch installation or recovery is running'); fi
else
    chmod 0700 "$root$state"
    [[ -e $root$lock ]] || touch "$root$lock"
    exec 9<"$root$lock"
    flock -n 9 || fail 'Another Couch installation or recovery is running.'
fi
missing_packages() {
    local package
    for package in "${packages[@]}"; do
        [[ $(dpkg-query -W -f='${db:Status-Status}' "$package" 2>/dev/null) = installed ]] || echo "$package"
    done
}
# Only the explicit setup command exposes these files to system services.
# Existing administrator files and masks take precedence, including disabled autologin.
# Prints "keep DESTINATION", or "copy|link DESTINATION TEMPLATE" for what to add.
plan_files() {
    local path destination found
    for path in "${files[@]}"; do
        [[ $path != usr/lib/systemd/user/couch-tv.service ]] || continue
        destination=/$path
        case "$path" in
            usr/share/lightdm/lightdm.conf.d/*) destination=/etc/lightdm/lightdm.conf.d/${path##*/} ;;
            usr/lib/systemd/logind.conf.d/*) destination=/etc/systemd/logind.conf.d/${path##*/} ;;
        esac
        # Sign-in and power policy is only ever set by the administrator's setup.
        [[ $mode = tv || $destination = /$path ]] || continue
        # What only root can see is unknown, never absent: it may be the administrator's file.
        found=0
        [[ $destination = /$path ]] || exists "/$path" || found=$?
        if [[ $found = 0 && $destination != /$path ]]; then echo "keep /$path"; continue; fi
        if [[ $found = 2 ]]; then echo "unknown /$path"; continue; fi
        found=0; exists "$destination" || found=$?
        if [[ $found = 0 ]]; then echo "keep $destination"
        elif [[ $found = 2 ]]; then echo "unknown $destination"
        elif [[ $destination = /etc/* ]]; then echo "copy $destination $path"
        else echo "link $destination $path"; fi
    done
}
# A mask keeps unattended updates off.
timer_masked() { [[ $(systemctl is-enabled couch-update.timer 2>/dev/null || true) = masked* ]]; }
install_files() {
    local action destination path
    while read -r action destination path; do
        if [[ $action = keep ]]; then echo "Preserved $destination"; continue; fi
        [[ $action != unknown ]] || fail "Can't tell whether $destination exists."
        install -d -m 0755 "$(dirname "$root$destination")"
        if [[ $action = copy ]]; then
            install -m "$(stat -c '%a' "$root$templates/$path")" "$root$templates/$path" "$root$destination"
        else
            ln -s "$templates/$path" "$root$destination"
        fi
    done < <(plan_files)
    systemctl daemon-reload
    timer_masked || systemctl enable --now couch-update.timer
}
# The administrator's /etc/couch/appliance.env, else the one setup would copy.
# Fails (2) when only root could read which.
data_dir() {
    local file=/etc/couch/appliance.env data found=0
    exists "$file" || found=$?
    case $found in
        0) [[ -r $root$file ]] || return 2 ;;
        2) return 2 ;;
        *) file=$templates/etc/couch/appliance.env ;;
    esac
    data=$(sed -n 's/^COUCH_DATA_DIR=//p' "$root$file" 2>/dev/null | tail -1)
    data=${data#\"}; echo "${data%\"}"
}
if [[ $mode = refresh ]]; then
    mapfile -t missing < <(missing_packages)
    # The update script already refreshed the package lists.
    [[ ${#missing[@]} = 0 ]] || DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends "${missing[@]}"
    install_files
    echo 'TV setup is current.'
    exit 0
fi
account=none
if getent passwd couch-tv >/dev/null; then
    if ! [[ $(getent passwd couch-tv | cut -d: -f6) = /var/lib/couch && $(id -Gn couch-tv) = couch-tv ]]; then account=other
    elif [[ $EUID != 0 ]]; then account=unknown unknown+=('Whether the couch-tv account is locked')
    elif [[ $(passwd -S couch-tv | awk '{print $2}') = L ]]; then account=dedicated
    else account=other; fi
fi
[[ $account != other ]] || refuse 'The existing couch-tv account is not the locked dedicated runtime account.'
unit=/etc/systemd/user/couch-tv.service
native_unit=$templates/usr/lib/systemd/user/couch-tv.service
native_selected() { [[ -L $root$unit && $(readlink "$root$unit") = "$native_unit" ]]; }
check_health() {
    for attempt in {1..20}; do
        pid=$(user_systemctl show couch-tv.service --property=MainPID --value)
        if as_user env ELECTRON_RUN_AS_NODE=1 "$root/usr/bin/couch" "$root$templates/check-health.js" "$pid" "$root$data" > "$root$state/health.json" 2> "$root$state/health-error.txt"; then return 0; fi
        sleep 1
    done
    cat "$root$state/health-error.txt" >&2
    return 1
}
# Preserve administrator overrides.
for override in /etc/systemd/system/couch-tv.service /etc/systemd/user/couch-tv.service.d "$user_home/.config/systemd/user/couch-tv.service" "$user_home/.config/systemd/user/couch-tv.service.d"; do
    if exists "$override"; then refuse "Inspect the existing service override before migration: $override"
    elif [[ $? = 2 ]]; then unknown+=("Whether $override exists"); fi
done
! exists "$unit" || native_selected || refuse 'Inspect the existing TV user unit before migration.'
if [[ -e $root/etc/X11/default-display-manager ]]; then
    if [[ $(cat "$root/etc/X11/default-display-manager") != /usr/sbin/lightdm ]]; then refuse 'Another display manager is configured. Keep the desktop or select LightDM deliberately.'
    elif [[ $previous = none ]]; then refuse 'LightDM already has a desktop policy. Use ordinary installation.'; fi
fi
if $inspect; then
    data_source=' (packaged default)'
    if ! data=$(data_dir); then data= data_source=' (only root can read /etc/couch/appliance.env)'
        unknown+=('Which data directory /etc/couch/appliance.env sets')
    elif exists /etc/couch/appliance.env; then data_source=' (from /etc/couch/appliance.env)'; fi
    # Only reads: the TV account's session, if root can see it.
    session=unknown
    if [[ $account = none ]]; then session=none
    elif [[ $EUID = 0 ]]; then
        session=stopped
        if [[ -S $root/run/user/$(id -u couch-tv)/bus ]] && user_systemctl is-active --quiet couch-tv.service; then session=running
        elif pgrep -u couch-tv -x couch >/dev/null; then session=writer; fi
    fi
    mapfile -t missing < <(missing_packages)
    query() { local value; value=$("$@" 2>/dev/null) || true; echo "${value:-unknown}"; }
    echo 'Couch TV setup inspection. Nothing was changed.'
    echo "Earlier setup: $previous"
    echo "Runtime account couch-tv: ${account/none/absent}"
    echo "Data directory: ${data:-unknown}$data_source"
    echo "Display manager: $(cat "$root/etc/X11/default-display-manager" 2>/dev/null || echo none); default target: $(query systemctl get-default); LightDM: $(query systemctl is-enabled lightdm.service)"
    echo "Unattended updates: couch-update.timer $(query systemctl is-enabled couch-update.timer)"
    actions+=("Refresh APT package lists and install or upgrade the TV packages${missing[*]:+ (missing: ${missing[*]})}")
    [[ $account != none ]] || actions+=('Create the locked couch-tv system account')
    if [[ -n $data ]] && exists "$data"; then kept+=("Existing data in $data")
    elif [[ $? = 2 ]]; then unknown+=("Whether $data holds data"); fi
    case $session in
        running) actions+=('Stop the running Couch TV app, then start it again and check its health') ;;
        writer) actions+=('Stop the Couch TV app; setup refuses if a Couch process remains') ;;
        unknown) unknown+=('Whether the Couch TV app is running') ;;
    esac
    while read -r action destination path; do
        case $action in
            keep) kept+=("$destination") ;;
            unknown) unknown+=("Whether $destination exists") ;;
            copy) actions+=("Copy $destination") ;;
            link) actions+=("Link $destination") ;;
        esac
    done < <(plan_files)
    if native_selected; then kept+=("$unit"); else actions+=("Link $unit"); fi
    if timer_masked; then kept+=('Masked couch-update.timer'); else actions+=('Enable and start couch-update.timer'); fi
    case $previous in
        complete) kept+=('Sign-in, boot target and power policy') ;;
        unknown) unknown+=('Whether setup enables LightDM and the graphical boot target') ;;
        *) actions+=('Enable LightDM and boot to graphical.target') ;;
    esac
    [[ ${#actions[@]} = 0 ]] || { echo 'Setup would:'; printf '  %s\n' "${actions[@]}"; }
    [[ ${#kept[@]} = 0 ]] || { echo 'Setup would keep:'; printf '  %s\n' "${kept[@]}"; }
    [[ ${#unknown[@]} = 0 ]] || { echo 'Unavailable:'; printf '  %s\n' "${unknown[@]}"; }
    if [[ ${#refusals[@]} != 0 ]]; then echo 'Setup would refuse:'; printf '  %s\n' "${refusals[@]}"; exit 1; fi
    echo 'Setup would proceed.'
    exit 0
fi
touch "$root$state/pending"
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends "${packages[@]}"
for package in "${packages[@]}"; do
    [[ $(dpkg-query -W -f='${db:Status-Status}' "$package") = installed ]] || fail "Debian package $package is missing. Repair APT and rerun setup."
done
if ! getent passwd couch-tv >/dev/null; then
    adduser --system --group --home /var/lib/couch --shell /bin/sh couch-tv
    as_user mkdir -p "$root$user_home/.local/state/couch-appliance"
    as_user touch "$root$user_home/.local/state/couch-appliance/initialize-audio"
fi
chgrp couch-tv "$root$lock"; chmod 0440 "$root$lock"
as_user env ELECTRON_RUN_AS_NODE=1 "$root/usr/bin/couch" --version > "$root$state/native-build.json" || fail 'The Couch app cannot start. The existing session was retained.'
was_running=false
if [[ -S $root/run/user/$(id -u couch-tv)/bus ]]; then
    if user_systemctl is-active --quiet couch-tv.service; then was_running=true; fi
    user_systemctl stop couch-tv.service
fi
! pgrep -u couch-tv -x couch >/dev/null || fail 'A Couch writer remains. Stop it before setup.'
install_files
data=$(data_dir) || fail "Can't read /etc/couch/appliance.env."
install -d -m 0755 "$root/etc/systemd/user"
if ! native_selected; then ln -s "$native_unit" "$root$unit"; fi
if [[ -S $root/run/user/$(id -u couch-tv)/bus ]]; then
    user_systemctl daemon-reload
    if $was_running; then
        user_systemctl reset-failed couch-tv.service || true
        if ! user_systemctl start couch-tv.service || ! check_health; then
            fail 'Native startup failed after setup. Inspect couch-session logs; existing data was retained.'
        fi
    fi
fi
if [[ $previous != complete ]]; then
    systemctl enable lightdm.service
    systemctl set-default graphical.target
fi
mv "$root$state/pending" "$root$state/complete"
sync -f "$root$state"
echo 'Native TV setup is ready. Reboot when convenient; keep your administrator account and SSH access.'
echo 'Inspect: sudo couch-session status; sudo couch-session logs'
