// Only the two fixed startup writes are available to the dedicated TV account.
polkit.addRule(function(action, subject) {
    if (subject.user === "couch-tv" &&
        action.id === "org.freedesktop.systemd1.manage-units" &&
        (action.lookup("unit") === "couch-autostart@enable.service" ||
         action.lookup("unit") === "couch-autostart@disable.service") &&
        action.lookup("verb") === "start") return polkit.Result.YES;
});
