// The dedicated TV account may only ask root to install an official Couch release by version.
polkit.addRule(function(action, subject) {
    if (subject.user === "couch-tv" &&
        action.id === "org.freedesktop.systemd1.manage-units" &&
        /^couch-update@[0-9]+\.[0-9]+\.[0-9]+(-preview\.[0-9]+)?\.service$/.test(action.lookup("unit")) &&
        action.lookup("verb") === "start") return polkit.Result.YES;
});
