#!/bin/bash
# Explicit SSH recovery replaces only a compatible known-good application.
set -euo pipefail
fail() { echo "couch-recover: $*" >&2; exit 1; }
[[ $EUID = 0 && $# = 1 ]] || fail 'Usage: sudo couch-recover /absolute/known-good-backup-directory'
backup=$(realpath "$1")
[[ -f $backup/Couch.AppImage && -f $backup/build.json && -f $backup/SHA256SUMS ]] || fail 'Expected a retained AppImage, build.json and SHA256SUMS.'
application=/var/lib/couch/application
[[ ! -L $application ]] || fail 'The application directory is a symbolic link; inspect it through SSH.'
exec 9>/run/couch-install.lock
flock -n 9 || fail 'Another installation or recovery is running.'
# The checksum is pinned when the known-good bundle is backed up, not downloaded
# from a feed during recovery. The operator chooses this retained snapshot.
(cd "$backup" && sha256sum --check --status SHA256SUMS) || fail 'Backup checksum mismatch.'
format=$(jq -er '.dataFormat | select(type == "number")' "$application/build.json")
[[ $(jq -er '.dataFormat' "$backup/build.json") = "$format" ]] || fail 'Incompatible data format. Keep current data and obtain a forward fix; do not restore an old database.'
couch-session stop
! pgrep -u couch-tv -x 'couch|couch-server' >/dev/null || fail 'A Couch writer remains; inspect it through SSH.'
data=$(sed -n 's/^COUCH_DATA_DIR=//p' /etc/couch/appliance.env | tail -1)
data=${data#\"}; data=${data%\"}
[[ $data = /* && -d $data ]] || fail 'The configured data directory is unavailable.'
failed="/var/lib/couch-installer/failed-$(date -u +%Y%m%dT%H%M%SZ)-$$"
install -d -m 0700 "$failed"
cp -a "$data" "$failed/data"
cp -a "$application/build.json" "$failed/"
if [[ -e $application/Couch.AppImage || -L $application/Couch.AppImage ]]; then
    cp -a "$application/Couch.AppImage" "$failed/"
else
    printf 'The current AppImage was absent before recovery.\n' > "$failed/missing-appimage.txt"
fi
sync -f "$failed"
runuser -u couch-tv -- sh -c 'umask 077; cat > /var/lib/couch/application/Couch.AppImage.new; chmod 0700 /var/lib/couch/application/Couch.AppImage.new' < "$backup/Couch.AppImage"
runuser -u couch-tv -- "$application/Couch.AppImage.new" --version > "$failed/recovery-build.json"
jq -e --slurpfile expected "$backup/build.json" '.version == $expected[0].version and .revision == $expected[0].revision and .dataFormat == $expected[0].dataFormat' "$failed/recovery-build.json" >/dev/null || fail 'The retained AppImage does not match its recorded build.'
jq --arg hash "$(sha256sum "$application/Couch.AppImage.new" | cut -d ' ' -f1)" '. + {archiveSha256:$hash}' "$failed/recovery-build.json" > "$failed/recovery-with-hash.json"
runuser -u couch-tv -- sh -c 'umask 077; cat > /var/lib/couch/application/build.json' < "$failed/recovery-with-hash.json"
runuser -u couch-tv -- mv -f "$application/Couch.AppImage.new" "$application/Couch.AppImage"
sync -f "$application"
couch-session restart
echo "Known-good application restored; current user data retained. Failed data saved in $failed."
echo 'Verify couch-session status/logs and retained phone reconnection before declaring recovery complete.'
