#!/usr/bin/python3 -I
"""Administrator receipt enrollment, phone-update activation and explicit trial restoration."""
import argparse
import json
import os
import sys

sys.path.insert(0, "/usr/lib/couch-appliance/updater")
from receipt import Rejected
from retention import Retention
from operator_client import enable, request
from transactions import TOKEN


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("status")
    commands.add_parser("enable")
    commands.add_parser("restore").add_argument("update_id")
    commands.add_parser("enroll-current").add_argument("receipt")
    args = parser.parse_args()
    if os.geteuid() != 0:
        parser.error("Run with sudo from the administrator account.")
    os.umask(0o077)
    try:
        storage = Retention()
        if args.command == "enroll-current":
            result = storage.enroll(args.receipt)
        elif args.command == "enable":
            result = enable(storage)
        elif args.command == "restore":
            if not TOKEN.fullmatch(args.update_id):
                raise Rejected("Use the exact updateId recorded by status.")
            result = request({"op": "restore", "updateId": args.update_id})
        else:
            result = {"current": storage.read("current.json"), "active": storage.read("active.json"), "phoneUpdates": "enabled" if os.path.isfile("/etc/couch/manual-updates.enabled") else "disabled"}
        print(json.dumps(result, indent=2))
    except (Rejected, OSError) as error:
        print(str(error) if isinstance(error, Rejected) else "Update storage could not be accessed safely.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
