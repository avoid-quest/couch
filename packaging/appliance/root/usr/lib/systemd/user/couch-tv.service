[Unit]
Description=Couch TV native host and coordinator
Wants=pipewire.service pipewire-pulse.service wireplumber.service
After=pipewire.service pipewire-pulse.service wireplumber.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
Environment=GDK_BACKEND=x11
Environment=COUCH_TV_PRESENTATION=1
EnvironmentFile=/etc/couch/appliance.env
EnvironmentFile=-/run/couch-appliance/recovery.env
ExecStartPre=/usr/bin/pactl info
ExecStartPre=/usr/lib/couch-appliance/initialize-audio
ExecStart=/var/lib/couch/application/Couch.AppImage
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=10
UMask=0077
MemoryHigh=2500M
MemorySwapMax=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=couch-tv
