[Unit]
Description=Couch authenticated package update worker
Requires=couch-updater.socket
After=couch-updater.socket

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/lib/couch-appliance/updater/serve.py
User=root
Group=root
UMask=0077
KillMode=control-group
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

# No Restart loop and no package-time activation. Interrupted work stays visible.
