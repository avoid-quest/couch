// Only the fixed Ubuntu dependency repair operation is available to Couch.
polkit.addRule(function(action, subject) {
    if (subject.user === "couch-tv" &&
        action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "couch-runtime-repair.service" &&
        action.lookup("verb") === "start") return polkit.Result.YES;
});
