#!/bin/bash
# Optional setup from the installed Debian package. Never run from a package hook.
set -euo pipefail
fail() { echo "couch-setup: $*" >&2; exit 1; }
trap 'status=$?; if [[ $status != 0 ]]; then echo "Setup did not complete. Existing data and AppImage files were retained. Inspect sudo couch-session logs; rerun couch-setup, or use sudo couch-setup --tv --restore-appimage after a recorded migration." >&2; fi' EXIT
usage='sudo couch-setup --tv [--restore-appimage] | --desktop-user USER'
tv=false restore=false desktop_user=
while [[ $# -gt 0 ]]; do
    case "$1" in
        --tv) tv=true; shift ;;
        --restore-appimage) restore=true; shift ;;
        --desktop-user) [[ $# -ge 2 ]] || fail "$usage"; desktop_user=$2; shift 2 ;;
        *) fail "$usage" ;;
    esac
done
[[ $EUID = 0 ]] || fail "$usage"
. /etc/os-release
[[ $ID = debian && $VERSION_ID = 13 && $(dpkg --print-architecture) = amd64 ]] || fail 'Supported target: Debian 13 amd64.'
[[ -d /run/systemd/system ]] || fail 'Boot Debian with systemd before setup.'
[[ $(dpkg-query -W -f='${db:Status-Status}' couch) = installed ]] || fail 'Install the native Couch package with APT first.'
[[ -x /usr/bin/couch ]] || fail 'The native Couch executable is missing. Reinstall its Debian package.'
if $tv; then
    [[ -z $desktop_user ]] || fail "$usage"
    desktop_user=couch-tv
    user_home=/var/lib/couch
    state=/var/lib/couch-installer/native-tv
    lock=/var/lib/couch-install-locks/tv.lock
else
    ! $restore || fail '--restore-appimage requires --tv.'
    [[ -n $desktop_user && $desktop_user != root && $desktop_user != couch-tv ]] || fail "$usage"
    user_home=$(getent passwd "$desktop_user" | cut -d: -f6)
    [[ $user_home = /* && -d $user_home ]] || fail 'Select an existing desktop account.'
    state=/var/lib/couch-installer/native-desktop-$(id -u "$desktop_user")
    lock=/var/lib/couch-install-locks/desktop-$(id -u "$desktop_user").lock
fi
as_user() { runuser -u "$desktop_user" -- env HOME="$user_home" "$@"; }
user_systemctl() { as_user env XDG_RUNTIME_DIR="/run/user/$(id -u "$desktop_user")" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u "$desktop_user")/bus" systemctl --user "$@"; }
# Fixed root-owned state and lock paths; do not follow substituted directories.
for directory in /var/lib/couch-installer /var/lib/couch-install-locks "$state"; do
    [[ ! -L $directory ]] || fail "Refusing symbolic link: $directory"
    [[ -d $directory ]] || install -d -m 0755 "$directory"
    [[ $(stat -c %u "$directory") = 0 && -z $(find "$directory" -maxdepth 0 -perm /022 -print) ]] || fail "Root must own $directory."
done
chmod 0700 "$state"
[[ ! -L $lock ]] || fail 'The installation lock is a symbolic link.'
[[ -e $lock ]] || touch "$lock"
exec 9<"$lock"
flock -n 9 || fail 'Another Couch installation or recovery is running.'
if ! $tv; then
    for directory in "$user_home" "$user_home/.local" "$user_home/.local/share" "$user_home/.local/share/applications" "$user_home/.local/bin"; do
        [[ ! -L $directory ]] || fail "Inspect the substituted desktop directory before migrating: $directory"
    done
    ! pgrep -u "$desktop_user" -x 'couch|couch-server' >/dev/null || fail 'Quit Couch before migrating its desktop launcher.'
    as_user /usr/bin/couch --version >/dev/null || fail 'The native app cannot start. The AppImage launcher was retained.'
    launcher=$user_home/.local/share/applications/couch.desktop
    recovery=$user_home/.local/bin/couch-recover
    if [[ -e $recovery || -L $recovery ]]; then
        [[ ! -L $recovery ]] && cmp -s "$recovery" /usr/share/couch/tv/couch-recover-appimage || fail 'Inspect the customized recovery command before migrating.'
        [[ ! -e $recovery.appimage-retained && ! -L $recovery.appimage-retained ]] || fail 'A retained recovery command already exists. Inspect it before migrating.'
    fi
    if [[ -e $launcher || -L $launcher ]]; then
        [[ ! -L $launcher ]] || fail 'Inspect the customized Couch launcher before migrating.'
        grep -Fxq "Exec=\"$user_home/.local/lib/couch/Couch.AppImage\"" "$launcher" || fail 'Inspect the customized Couch launcher before migrating.'
        [[ ! -e $state/couch.desktop ]] || fail 'A launcher backup already exists. Inspect it before migrating again.'
        [[ ! -e $launcher.appimage-retained && ! -L $launcher.appimage-retained ]] || fail 'A retained launcher already exists. Inspect it before migrating.'
        cp -a "$launcher" "$state/couch.desktop"
        as_user mv "$launcher" "$launcher.appimage-retained"
    fi
    if [[ -f $recovery ]]; then as_user mv "$recovery" "$recovery.appimage-retained"; fi
    echo 'Launch Couch from its native application-menu entry. The AppImage and all user data remain in place.'
    echo "Retained launcher: $launcher.appimage-retained"
    exit 0
fi
if getent passwd couch-tv >/dev/null; then
    [[ $(getent passwd couch-tv | cut -d: -f6) = /var/lib/couch && $(id -Gn couch-tv) = couch-tv && $(passwd -S couch-tv | awk '{print $2}') = L ]] || fail 'The existing couch-tv account is not the locked dedicated runtime account.'
fi
templates=/usr/share/couch/tv
unit=/etc/systemd/user/couch-tv.service
native_unit=$templates/usr/lib/systemd/user/couch-tv.service
old_app=/var/lib/couch/application/Couch.AppImage
native_selected() { [[ -L $unit && $(readlink "$unit") = "$native_unit" ]]; }
format() { sed -nE 's/.*"dataFormat"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p'; }
check_health() {
    for attempt in {1..20}; do
        pid=$(user_systemctl show couch-tv.service --property=MainPID --value)
        if as_user /usr/lib/Couch/tools/deno run --no-prompt --allow-all "$templates/check-health.js" "$pid" /usr/lib/Couch/release.json "$data" > "$state/health.json" 2> "$state/health-error.txt"; then return 0; fi
        sleep 1
    done
    cat "$state/health-error.txt" >&2
    return 1
}
restore_selection() {
    [[ -f $state/appimage.sha256 && -x $old_app ]] || fail 'No retained AppImage migration is recorded.'
    sha256sum --check --status "$state/appimage.sha256" || fail 'The retained AppImage changed. Inspect it before recovery.'
    native_selected || fail 'The TV unit has changed. Inspect the administrator configuration before recovery.'
    current_format=$(as_user /usr/bin/couch --version | format)
    [[ -n $current_format && $current_format = "$(cat "$state/data-format")" ]] || fail 'Data formats differ. Obtain a compatible forward fix; do not restore an old database.'
    user_systemctl stop couch-tv.service
    ! pgrep -u couch-tv -x 'couch|couch-server' >/dev/null || fail 'A Couch writer remains. Inspect couch-session logs.'
    rm "$unit"
    user_systemctl daemon-reload
    user_systemctl reset-failed couch-tv.service || true
    user_systemctl start couch-tv.service
    rm -f "$state/complete"
    echo 'Restored the retained AppImage service selection. Current data was not replaced.'
}
if $restore; then restore_selection; exit 0; fi
# Preserve administrator overrides. The old release used the vendor user unit.
for override in /etc/systemd/system/couch-tv.service /etc/systemd/user/couch-tv.service.d "$user_home/.config/systemd/user/couch-tv.service" "$user_home/.config/systemd/user/couch-tv.service.d"; do
    [[ ! -e $override && ! -L $override ]] || fail "Inspect the existing service override before migration: $override"
done
[[ ! -e $unit && ! -L $unit ]] || native_selected || fail 'Inspect the existing TV user unit before migration.'
if [[ -e /etc/X11/default-display-manager ]]; then
    [[ $(cat /etc/X11/default-display-manager) = /usr/sbin/lightdm ]] || fail 'Another display manager is configured. Keep the desktop or select LightDM deliberately.'
    [[ -f /var/lib/couch-installer/tv-setup.complete || -f $state/pending || -f $state/complete ]] || fail 'LightDM already has a desktop policy. Use ordinary installation.'
fi
touch "$state/pending"
mapfile -t packages < "$templates/packages"
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends "${packages[@]}"
for package in "${packages[@]}"; do
    [[ $(dpkg-query -W -f='${db:Status-Status}' "$package") = installed ]] || fail "Debian package $package is missing. Repair APT and rerun setup."
done
if ! getent passwd couch-tv >/dev/null; then
    adduser --system --group --home /var/lib/couch --shell /bin/sh couch-tv
    as_user mkdir -p "$user_home/.local/state/couch-appliance"
    as_user touch "$user_home/.local/state/couch-appliance/initialize-audio"
fi
chgrp couch-tv "$lock"; chmod 0440 "$lock"
as_user /usr/bin/couch --version > "$state/native-build.json" || fail 'The native app cannot start. The existing session was retained.'
# Validate a retained installation before exposing login or power configuration.
if [[ ! -f $state/appimage.sha256 && -x $old_app ]]; then
    [[ -f /usr/lib/systemd/user/couch-tv.service ]] || fail 'The retained AppImage has no vendor TV unit. Inspect the installation.'
    cmp -s /usr/lib/systemd/user/couch-tv.service <(sed 's|ExecStart=/usr/bin/couch|ExecStart=/var/lib/couch/application/Couch.AppImage|' "$native_unit") || fail 'The AppImage service was customized. Inspect it before migration.'
    [[ ! -L $old_app && ! -L ${old_app%/*} ]] || fail 'Inspect the substituted AppImage path before migration.'
    as_user "$old_app" --version > "$state/appimage-build.json"
    old_format=$(format < "$state/appimage-build.json")
    [[ -n $old_format && $old_format = "$(format < "$state/native-build.json")" ]] || fail 'The AppImage and native data formats differ. Keep the current installation.'
    data=$(sed -n 's/^COUCH_DATA_DIR=//p' /etc/couch/appliance.env | tail -1)
    data=${data#\"}; data=${data%\"}
    [[ $data = /* && -d $data && ! -L $data ]] || fail 'Inspect the configured data directory before migration.'
    printf '%s\n' "$old_format" > "$state/data-format"
    sha256sum "$old_app" > "$state/appimage.sha256"
fi
was_running=false
if [[ -S /run/user/$(id -u couch-tv)/bus ]]; then
    if user_systemctl is-active --quiet couch-tv.service; then was_running=true; fi
    user_systemctl stop couch-tv.service
fi
! pgrep -u couch-tv -x 'couch|couch-server' >/dev/null || fail 'A Couch writer remains. Stop it before switching the service.'
if [[ -f $state/appimage.sha256 && ! -e $state/data ]]; then
    data=$(sed -n 's/^COUCH_DATA_DIR=//p' /etc/couch/appliance.env | tail -1)
    data=${data#\"}; data=${data%\"}
    [[ $data = /* && -d $data && ! -L $data ]] || fail 'Inspect the configured data directory before migration.'
    cp -a "$data" "$state/data"
    sync -f "$state"
fi
# Only the explicit setup command exposes these files to system services.
# Existing administrator files and masks take precedence, including disabled autologin.
while IFS= read -r path; do
    [[ $path != usr/lib/systemd/user/couch-tv.service ]] || continue
    destination=/$path
    case "$path" in
        usr/share/lightdm/lightdm.conf.d/*) destination=/etc/lightdm/lightdm.conf.d/${path##*/} ;;
        usr/lib/systemd/logind.conf.d/*) destination=/etc/systemd/logind.conf.d/${path##*/} ;;
    esac
    if [[ $destination != /$path && ( -e /$path || -L /$path ) ]]; then
        echo "Preserved /$path"
        continue
    fi
    if [[ -e $destination || -L $destination ]]; then
        echo "Preserved $destination"
        continue
    fi
    install -d -m 0755 "$(dirname "$destination")"
    if [[ $destination = /etc/* ]]; then
        install -m "$(stat -c '%a' "$templates/$path")" "$templates/$path" "$destination"
    else
        ln -s "$templates/$path" "$destination"
    fi
done < "$templates/files"
systemctl daemon-reload
data=$(sed -n 's/^COUCH_DATA_DIR=//p' /etc/couch/appliance.env | tail -1)
data=${data#\"}; data=${data%\"}
install -d -m 0755 /etc/systemd/user
if ! native_selected; then ln -s "$native_unit" "$unit"; fi
if [[ -S /run/user/$(id -u couch-tv)/bus ]]; then
    user_systemctl daemon-reload
    if $was_running; then
        user_systemctl reset-failed couch-tv.service || true
        if ! user_systemctl start couch-tv.service || ! check_health; then
            if [[ -f $state/appimage.sha256 ]]; then
                echo 'Native startup failed. Restoring the retained AppImage selection.' >&2
                restore_selection
            fi
            fail 'Native migration did not complete. Inspect couch-session logs; retained app files and current data remain available.'
        fi
    fi
fi
if [[ ! -f /var/lib/couch-installer/tv-setup.complete && ! -f $state/complete ]]; then
    systemctl enable lightdm.service
    systemctl set-default graphical.target
fi
mv "$state/pending" "$state/complete"
sync -f "$state"
echo 'Native TV setup is ready. Reboot when convenient; keep your administrator account and SSH access.'
echo 'Inspect: sudo couch-session status; sudo couch-session logs'
if [[ -f $state/appimage.sha256 ]]; then echo 'Retained-app recovery: sudo couch-setup --tv --restore-appimage'; fi
