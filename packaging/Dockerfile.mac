# Linux build/qualification tools for the temporary Mac delivery path.
# Pass the source revision's pins as documented in docs/tauri-releases.md.
ARG DEBIAN_IMAGE=debian:13-slim@sha256:abc9cb88a5587630d7f915f47b23b0668fe250fbfc6457aa4d52b534c1bbf73f
ARG COUCH_BUILD_PLATFORM=linux/amd64
FROM --platform=${COUCH_BUILD_PLATFORM} ${DEBIAN_IMAGE}
ARG DEBIAN_SNAPSHOT=20260914T000000Z
ARG BUN_VERSION
ARG RUST_VERSION
ENV DEBIAN_FRONTEND=noninteractive
RUN test -n "$DEBIAN_SNAPSHOT" \
    && rm /etc/apt/sources.list.d/debian.sources \
    && printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/%s trixie main\ndeb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/%s trixie-security main\n' "$DEBIAN_SNAPSHOT" "$DEBIAN_SNAPSHOT" > /etc/apt/sources.list \
    && apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
       build-essential ca-certificates curl git pkg-config unzip file \
       libwebkit2gtk-4.1-dev libxdo-dev libssl-dev libmpv-dev libgl-dev \
       ffmpeg libfuse2t64 fuse3 librsvg2-dev patchelf jq acl procps minisign \
       libgdk-pixbuf2.0-bin libgtk-3-bin gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
       gstreamer1.0-libav libnss3 libasound2-plugins squashfs-tools \
    && rm -rf /var/lib/apt/lists/*
RUN test -n "$BUN_VERSION" \
    && curl --proto '=https' --tlsv1.2 -fsSL https://bun.sh/install -o /tmp/install-bun.sh \
    && bash /tmp/install-bun.sh "bun-v$BUN_VERSION" \
    && cp /root/.bun/bin/bun /usr/local/bin/bun \
    && rm /tmp/install-bun.sh
RUN test -n "$RUST_VERSION" \
    && curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs -o /tmp/rustup.sh \
    && sh /tmp/rustup.sh -y --profile minimal --default-toolchain "$RUST_VERSION" \
    && rm /tmp/rustup.sh
ENV PATH="/root/.cargo/bin:${PATH}" CARGO_BUILD_JOBS=2 PATCHELF=/usr/bin/patchelf
CMD ["sleep", "infinity"]
