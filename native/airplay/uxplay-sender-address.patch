@@ -137,6 +137,20 @@ raop_rtp_parse_remote(raop_rtp_t *raop_rtp, const char *remote, int remotelen)
     return 0;
 }
 
+/* Couch: audio and control packets count only from the sender's own address, on the same
+ * interface for an IPv6 link-local one (its scope, which accept() gave the RTSP connection). The data
+ * socket otherwise accepts any host, and a payload shorter than one AES block is never decrypted, so
+ * another host could add sound to a sender's stream without its key. */
+static bool
+raop_rtp_from_remote(raop_rtp_t *raop_rtp, struct sockaddr_storage *saddr)
+{
+    int length = 0, remote_length = 0;
+    unsigned int zone = 0, remote_zone = 0;
+    unsigned char *address = netutils_get_address(saddr, &length, &zone, NULL);
+    unsigned char *remote = netutils_get_address(&raop_rtp->remote_saddr, &remote_length, &remote_zone, NULL);
+    return address && remote && length == remote_length && zone == remote_zone && !memcmp(address, remote, length);
+}
