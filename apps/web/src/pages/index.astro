---
import { Image } from "astro:assets";
import couch from "../assets/couch.png";
import Analytics from "../components/Analytics.astro";
import "../styles.css";

const description = "A free, open-source media player everyone shares. Phones and laptops join with a QR code to choose what plays, play it, or share their own screen and sound.";
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>couch.avoid.quest</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:site_name" content="couch.avoid.quest" />
    <meta property="og:title" content="couch.avoid.quest" />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Analytics />
  </head>
  <body>
    <main>
      <h1>couch.avoid.quest</h1>
      <a class="sofa" href="/download" aria-label="Download Couch">
        <Image src={couch} alt="" widths={[320, 640, 830]} sizes="26vw" format="webp" loading="eager" />
        <span aria-hidden="true">download</span>
      </a>
      <a class="about" href="/about">Avoid the couch. <u>About Couch</u></a>
    </main>
    <script>
      // The couch avoids the pointer a few times, then gives up and waits to be caught.
      // Left alone for a while, it walks back to its spot and plays again.
      const sofa = document.querySelector<HTMLAnchorElement>(".sofa")!;
      // Touch has no hover: tapping the name shows what Couch is.
      const about = document.querySelector(".about")!;
      document.querySelector("h1")!.addEventListener("click", () => about.classList.toggle("shown"));
      const DODGES = 6;
      let dodges = DODGES, busy = false, rest = 0;
      addEventListener("resize", () => { sofa.style.translate = ""; sofa.classList.remove("caught"); dodges = DODGES; clearTimeout(rest); });
      addEventListener("pointermove", e => {
        if (busy || !dodges || e.pointerType !== "mouse" || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const r = sofa.getBoundingClientRect();
        if (Math.hypot(Math.max(r.left - e.clientX, 0, e.clientX - r.right), Math.max(r.top - e.clientY, 0, e.clientY - r.bottom)) > 40) return;
        // Of a few directions away from the pointer, take the one that ends farthest from it.
        const away = Math.atan2(r.top + r.height / 2 - e.clientY, r.left + r.width / 2 - e.clientX);
        let best = [r.left, r.top], far = -1;
        for (let i = 0; i < 12; i++) {
          const a = away + (Math.random() - .5) * 2.4;
          const nx = Math.min(Math.max(r.left + Math.cos(a) * 220, 0), innerWidth - r.width);
          const ny = Math.min(Math.max(r.top + Math.sin(a) * 220, 0), innerHeight - r.height);
          const d = Math.hypot(nx + r.width / 2 - e.clientX, ny + r.height / 2 - e.clientY);
          if (d > far) [far, best] = [d, [nx, ny]];
        }
        sofa.style.translate = `${best[0]}px ${best[1]}px`;
        sofa.classList.toggle("caught", !--dodges);
        clearTimeout(rest);
        rest = setTimeout(() => {
          sofa.style.translate = "";
          sofa.classList.remove("caught");
          dodges = DODGES;
        }, 4000);
        busy = true;
        setTimeout(() => { busy = false; }, 400);
      });
    </script>
  </body>
</html>

<style>
  body { overflow: hidden; }
  main { position: fixed; inset: 0; display: grid; place-items: center; }
  h1 { font-family: var(--font-display); font-size: 11.4vw; font-weight: 700; line-height: 1; letter-spacing: -0.04em; white-space: nowrap; user-select: none; }
  /* The couch inverts wherever it crosses the name. */
  .sofa { position: fixed; top: 0; left: 0; width: clamp(9rem, 26vw, 26rem); translate: calc(50vw - 50%) calc(50svh - 50%); mix-blend-mode: difference; outline: none; transition: translate .4s cubic-bezier(.2, .9, .3, 1.2), scale .4s; }
  .sofa img { display: block; width: 100%; height: auto; filter: contrast(1.3) brightness(.9); }
  .sofa span { position: absolute; top: 100%; left: 50%; translate: -50% .5rem; opacity: 0; transition: opacity .15s; }
  .sofa:is(:hover, :focus-visible, .caught) span { opacity: 1; }
  .sofa.caught { scale: .94; transition-delay: 0s, .4s; }
  .sofa:focus-visible { outline: 2px solid #fff; outline-offset: .5rem; }
  /* Hovering or tapping the name says what Couch is; it lingers so the pointer can reach it. */
  .about { position: fixed; top: calc(50svh + 9vw); left: 50%; translate: -50% 0; width: max-content; max-width: calc(100vw - 2 * var(--gutter)); text-align: center; font-size: .875rem; color: var(--muted-foreground); opacity: 0; pointer-events: none; transition: opacity .15s .8s, pointer-events 0s .8s; transition-behavior: allow-discrete; }
  .about u { color: var(--foreground); text-underline-offset: .2em; }
  :is(h1:hover ~ .about, .about:hover, .about:focus-visible, .about.shown) { opacity: 1; pointer-events: auto; transition-delay: 0s; }
  @media (prefers-reduced-motion: reduce) { .sofa { transition: none; } }
</style>
