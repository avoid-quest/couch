---
import "../styles.css";
import releases from "../releases.json";
import { buttonVariants } from "../../../../src/client/components/ui/button";
import { downloadUrl, type Channel } from "../../../../scripts/hosted-policy";

type Release = { version: string; checkedAt: string; format?: string; url?: string };
const ready = releases as Record<Channel, Release | null>;
const stable = ready.stable?.format === "deb" ? ready.stable : null;
const preview = ready.preview?.format === "deb" ? ready.preview : null;
const primary = stable ?? preview;
const channel: Channel = stable ? "stable" : "preview";
const filename = (release: Release) => `Couch_${release.version}_amd64.deb`;
const url = (release: Release, channel: Channel) => release.url ?? downloadUrl(filename(release), channel);
const newerPreview = stable && preview && preview.version.localeCompare(stable.version, "en", { numeric: true }) > 0;
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Download Couch</title>
    <meta name="description" content="Install Couch on Debian 13. One package for your desktop or dedicated TV." />
    <link rel="canonical" href={new URL("/download", Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/avoid.svg" />
  </head>
  <body>
    <main class="downloads">
      <nav aria-label="Home"><a href="/">couch.avoid.quest</a></nav>
      <header>
        <h1>Couch for Debian</h1>
        <p class="intro">One package for your desktop or dedicated TV.</p>
        <p class="target">Debian 13 · Intel or AMD 64-bit · X11 desktop</p>
        {primary ? <div class="download">
          <a class={buttonVariants({ size: "lg" })} href={url(primary, channel)}>
            Download Couch{channel === "preview" ? " Preview" : ""}
          </a>
          <span>Version {primary.version} · .deb</span>
        </div> : <p>A verified Debian package is not available yet.</p>}
      </header>

      {primary && <section aria-labelledby="install">
        <h2 id="install">Install and open</h2>
        <ol>
          <li>Download the package above.</li>
          <li>Open a terminal in the folder where you saved it, then run:
            <pre><code>{`sudo apt install ./${filename(primary)}`}</code></pre>
            <p class="muted">Enter your computer's administrator password. Debian installs the app and its dependencies.</p>
          </li>
          <li>Open <strong>Couch</strong> from your applications menu and choose <strong>This computer</strong>. Allow remote control if you want to pair your phone.</li>
        </ol>
      </section>}

      {primary && <section aria-labelledby="tv">
        <details>
          <summary id="tv">Using a dedicated TV?</summary>
          <p>After installing the package, run:</p>
          <pre><code>sudo couch-setup --tv</code></pre>
          <p>This sets up a dedicated Couch account, automatic sign-in and TV power settings. Your administrator account stays available. Reboot to enter the Couch session.</p>
          <p>On first use, choose <strong>This computer</strong>, allow remote control, and pair your phone using the code on screen. Migrating an existing Couch TV keeps its data and paired devices.</p>
        </details>
      </section>}

      {primary && <section aria-labelledby="updates">
        <h2 id="updates">Updates from your phone</h2>
        <p>A paired Administrator can install updates from Couch's settings. Updates are signed and verified by the app. Automatic updates are optional and wait for ten continuous idle minutes.</p>
      </section>}

      {newerPreview && preview && <section aria-labelledby="preview">
        <details>
          <summary id="preview">Try the next release</summary>
          <p>Preview {preview.version} is available for testing. Install it with the same steps, using its filename:</p>
          <p><a href={url(preview, "preview")}>Download Couch Preview {preview.version}</a></p>
          <pre><code>{`sudo apt install ./${filename(preview)}`}</code></pre>
          <p>Switching back to Stable waits for a newer Stable release.</p>
        </details>
      </section>}

      <footer>Dependency licenses and notices are included in the package.</footer>
    </main>
  </body>
</html>
<style>
  .downloads { display: block; position: static; max-width: 42rem; margin: auto; padding: 2rem 1.5rem 3rem; }
  nav, .target, .download span, .muted, footer { color: var(--muted-foreground); }
  nav { font-size: .85rem; }
  header { margin: 4rem 0 3rem; }
  .downloads h1 { position: static; font-size: clamp(2rem, 6vw, 3rem); font-weight: 500; line-height: 1.1; letter-spacing: -.05em; margin: 0 0 1rem; }
  .intro { font-size: 1.1rem; }
  .target { font-size: .85rem; margin-top: 1.25rem; }
  .download { display: flex; align-items: flex-start; flex-direction: column; gap: .75rem; margin-top: 1.5rem; }
  .download a { min-height: 2.75rem; padding-inline: 1.25rem; font-size: .875rem; }
  .download a:hover { text-decoration: none; }
  .download span { font-size: .8rem; }
  section { border-top: 1px solid var(--border); padding: 1.5rem 0; }
  h2, summary { font-size: 1rem; font-weight: 500; }
  summary { cursor: pointer; }
  p, li { font-size: .95rem; line-height: 1.65; }
  p { margin: .75rem 0; }
  ol { padding-left: 1.25rem; list-style: decimal; }
  li { margin-top: 1rem; padding-left: .25rem; }
  li .muted { font-size: .85rem; }
  section a { text-decoration: underline; }
  pre { overflow-x: auto; margin: .75rem 0; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--muted); font-size: .8rem; }
  footer { font-size: .8rem; margin-top: 1.5rem; }
</style>
