---
import "../styles.css";
import releases from "../releases.json";
import { downloadUrl, publicFiles, type Channel } from "../../../../scripts/hosted-policy";
const channels: Channel[] = ["stable", "preview"];
const ready = releases as Record<Channel, { version: string; checkedAt: string } | null>;
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Download Couch</title>
    <meta name="description" content="Signed Couch downloads for Debian 13 desktops and TV devices." />
    <link rel="icon" type="image/svg+xml" href="/avoid.svg" />
  </head>
  <body>
    <main class="downloads">
      <a href="/">couch.avoid.quest</a>
      <h1>Download Couch</h1>
      <p>One signed app for Debian 13, amd64, in an X11 session. Install on your desktop or choose the dedicated TV setup.</p>
      {channels.map(channel => {
        const release = ready[channel];
        return <section aria-label={channel === "stable" ? "Stable downloads" : "Preview downloads"}>
          <h2>{channel === "stable" ? "Stable" : "Preview"}</h2>
          <p>{channel === "stable" ? "For everyday use." : "Try releases before they reach Stable."}</p>
          {release ? <>
            <p>Version {release.version}</p>
            <ul>{publicFiles(release.version).map(file => <li><a href={downloadUrl(file, channel)}>{file}</a></li>)}</ul>
            <p>Download the AppImage, setup archive and their signatures. The distribution material contains dependency notices and approved dependency material.</p>
          </> : <p>A verified download is not available yet.</p>}
        </section>;
      })}
      {channels.some(channel => ready[channel]) && <section>
        <h2>Verify and install</h2>
        <p>Save the <a href="/couch-updater.pub" download>enrolled public key</a> from this HTTPS site. Use Debian's Minisign to verify the setup archive before extracting it. The verified setup checks the AppImage before it runs.</p>
        <pre><code>{`sudo apt-get update
sudo apt-get install minisign jq
base64 --decode couch-updater.pub > couch-updater.minisign.pub
base64 --decode couch-setup-VERSION.tar.gz.sig > couch-setup.minisig
minisign -Vm couch-setup-VERSION.tar.gz -p couch-updater.minisign.pub -x couch-setup.minisig`}</code></pre>
        <p>Replace VERSION with the version you downloaded. Continue only after verification succeeds, then follow README.md inside the signed setup archive for desktop or TV installation.</p>
      </section>}
      <p>Couch updates each installation independently. Manual installation is the default; Auto when idle waits for ten continuous idle minutes. Switching to Stable waits for a newer Stable release and never downgrades your app.</p>
    </main>
  </body>
</html>
<style>
  .downloads { display: block; position: static; max-width: 48rem; margin: auto; padding: 3rem 1.5rem; }
  .downloads h1 { position: static; font-size: 2rem; margin: 2rem 0 1rem; }
  h2 { font-size: 1.3rem; margin: 1.5rem 0 .5rem; }
  section { border-top: 1px solid var(--border); margin-top: 2rem; padding-top: .5rem; }
  p { margin: .75rem 0; line-height: 1.6; }
  ul { padding-left: 1.25rem; list-style: disc; overflow-wrap: anywhere; }
  li { margin: .5rem 0; }
  a { text-decoration: underline; }
  pre { overflow-x: auto; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius); font-size: .85rem; }
</style>
